{
  "name": "homebridge-centsys",
  "version": "1.1.3",
  "description": "CENTURION / CENTSYS SMART+ gate monitoring and control for Homebridge",
  "type": "module",
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanvanniekerk/homebridge-centsys.git"
  },
  "scripts": {
    "build": "rimraf dist homebridge-ui/public/app.js && tsc -p tsconfig.json && tsc -p tsconfig.ui.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.ui.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "check:runtime": "npm run typecheck && npm run build && npm test",
    "check": "biome check . && npm run check:runtime",
    "prepare:auth": "npm run build && node dist/prepare-auth.js",
    "diagnose": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "22.20.1",
    "@types/proper-lockfile": "4.1.4",
    "homebridge": "2.4.0",
    "rimraf": "6.1.3",
    "typescript": "6.0.3",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6",
    "mqtt": "5.15.2",
    "proper-lockfile": "4.1.2",
    "zod": "4.6.5"
  },
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "keywords": [
    "homebridge-plugin",
    "supports-hap",
    "centurion",
    "centurion-gates",
    "centsys",
    "gate",
    "gate-opener"
  ],
  "files": [
    "dist/**/*.js",
    "homebridge-ui/server.js",
    "homebridge-ui/public/app.js",
    "homebridge-ui/public/index.html",
    "homebridge-ui/public/style.css",
    "resources/centsys-ca.crt",
    "config.schema.json",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/INSTALLATION.md",
    "docs/VALIDATION.md",
    "docs/PROJECT_STRUCTURE.md",
    "scripts/check-release.mjs",
    "scripts/release-notes.mjs",
    "docs/RELEASING.md"
  ],
  "author": "Dean van Niekerk",
  "homepage": "https://github.com/deanvanniekerk/homebridge-centsys#readme",
  "bugs": {
    "url": "https://github.com/deanvanniekerk/homebridge-centsys/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "latest",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@10.9.8"
}
