{
  "name": "homebridge-centsys",
  "version": "0.1.0-alpha.8",
  "description": "CENTSYS SMART+ gate monitoring and experimental control for Homebridge",
  "type": "module",
  "engines": {
    "node": "^22 || ^24",
    "homebridge": "^2.4.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deanvanniekerk/homebridge-centsys.git"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.mjs",
    "format": "prettier --write src test package.json tsconfig.json .github/workflows scripts homebridge-ui config.schema.json",
    "format:check": "prettier --check src test package.json tsconfig.json .github/workflows scripts homebridge-ui config.schema.json",
    "check": "npm run format:check && npm test",
    "prepare:auth": "npm run build && node dist/prepare-auth.js",
    "diagnose": "npm run build && node dist/cli.js",
    "prepack": "npm run build",
    "prepublishOnly": "node scripts/check-release.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/proper-lockfile": "4.1.4",
    "homebridge": "2.4.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@homebridge/plugin-ui-utils": "2.2.6",
    "mqtt": "5.15.2",
    "proper-lockfile": "4.1.2"
  },
  "main": "dist/index.js",
  "exports": "./dist/index.js",
  "keywords": [
    "homebridge-plugin"
  ],
  "files": [
    "dist/*.js",
    "homebridge-ui/",
    "resources/centsys-ca.crt",
    "config.schema.json",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "docs/INSTALLATION.md",
    "docs/VALIDATION.md",
    "scripts/check-release.mjs",
    "docs/RELEASING.md"
  ],
  "author": "Dean van Niekerk",
  "homepage": "https://github.com/deanvanniekerk/homebridge-centsys#readme",
  "bugs": {
    "url": "https://github.com/deanvanniekerk/homebridge-centsys/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha",
    "registry": "https://registry.npmjs.org/"
  },
  "packageManager": "npm@10.9.8"
}
